+bool guest_bytes_equal(uint8_t* rdram, gpr guest, const u8* host, std::size_t size) {
+    if (guest == 0) return true;
+    for (std::size_t i = 0; i < size; ++i) {
+        if (u8(MEM_BU(i, guest)) != host[i]) return false;
+    }
+    return true;
+}
